{
  "kind": "collectionType",
  "collectionName": "visit_reports",
  "info": {
    "singularName": "visit-report",
    "pluralName": "visit-reports",
    "displayName": "Visit Report",
    "description": "Field visit reports submitted by canvassers"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "inversedBy": "visit_reports",
      "required": true
    },
    "latitude": {
      "type": "float",
      "required": true
    },
    "longitude": {
      "type": "float",
      "required": true
    },
    "order_notes": {
      "type": "text",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    }
  }
}
